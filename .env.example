# Copy to ".env" on the NAS and adjust. Docker Compose reads .env automatically.

# --- Timezone (IANA name) — used by Schedule Trigger and the OS in the container ---
TZ=Europe/London
GENERIC_TIMEZONE=Europe/London

# --- How n8n advertises its URL (important for OAuth, emails, webhooks) ---
# LAN-only HTTP example (replace IP with your NAS):
N8N_HOST=192.168.1.10
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://192.168.1.10:5678/
# HTTPS behind reverse proxy example:
# N8N_HOST=n8n.yourdomain.com
# N8N_PORT=443
# N8N_PROTOCOL=https
# WEBHOOK_URL=https://n8n.yourdomain.com/

# Must be "false" when using plain HTTP (typical on LAN without TLS).
N8N_SECURE_COOKIE=false

# Set to 1 if you terminate TLS at Synology / nginx / Traefik in front of n8n.
N8N_PROXY_HOPS=0

# Host port published to the NAS (container stays on 5678 internally).
N8N_PUBLISH_PORT=5678

# --- Coolify (Git → Docker Compose resource) ---
# In Coolify: New Resource → Docker Compose → your repo; set Base Directory / compose path if needed.
# Assign a domain to service "n8n" on container port 5678. The compose file can use Coolify magic
# vars SERVICE_URL_N8N_5678 and SERVICE_FQDN_N8N as fallbacks (requires Coolify v4 beta.411+ for Git).
# For HTTPS through Coolify’s proxy, set in the Coolify UI (or .env):
#   N8N_PROTOCOL=https
#   N8N_PORT=443
#   N8N_SECURE_COOKIE=true
#   N8N_PROXY_HOPS=1
# Or set WEBHOOK_URL / N8N_HOST explicitly and omit reliance on magic variables.
